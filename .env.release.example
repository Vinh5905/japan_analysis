# Copy this file to .env on the machine that runs docker-compose.release.yml.
# The crawler image contains the Python source code; these variables only
# configure runtime services, credentials, and ports.

TZ=Asia/Ho_Chi_Minh
RELEASE_COMPOSE_PROJECT_NAME=suumo_crawler_release

# Docker Hub image published by the maintainer.
SUUMO_CRAWLER_IMAGE=kevinpham9257/suumo-crawler
SUUMO_CRAWLER_TAG=latest

# PostgreSQL runtime. POSTGRES_PORT is the host port; containers still connect
# to postgres:5432 inside the compose network.
POSTGRES_IMAGE=postgres:16.3-bookworm
POSTGRES_DB=suumo_crawler
POSTGRES_USER=suumo_user
POSTGRES_PASSWORD=suumo_password_change_me
POSTGRES_PORT=5432
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C
PGDATA=/var/lib/postgresql/data/pgdata

# MinIO runtime. MINIO_API_PORT and MINIO_CONSOLE_PORT are host ports.
MINIO_IMAGE=minio/minio:RELEASE.2024-07-16T23-46-41Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-07-15T17-46-06Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Comma-separated bucket names. crawler-init runs main.py to create these
# buckets and the configured prefixes.
MINIO_DEFAULT_BUCKETS=suumo
MINIO_MAIN_BUCKET=suumo
MINIO_MAIN_BUCKET_PREFIXES=data/,page_source/,image/

# A host directory mounted into /app/crawler/tmp so link files, preview output,
# and manual rerun reports survive one-shot containers.
CRAWLER_TMP_DIR=./tmp

# Scrapy knobs. Leave 0 to process all available records.
SUUMO_HTML_LINKS_FILE=tmp/suumo_links.txt
SUUMO_HTML_LINK_LIMIT=0
SUUMO_PAGE_TASK_LIMIT=0
SUUMO_PAGE_BATCH_SIZE=100
SUUMO_PAGE_BATCH_SECONDS=300
SUUMO_RUN_CREATED_BY=schedule
